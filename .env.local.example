# Get Paid To Post — environment variables
# Copy this file to .env.local and fill in your own Supabase project values.
# NEVER put the Supabase service_role key in this project or in chat.
# Only the two public values below are needed by the website.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
